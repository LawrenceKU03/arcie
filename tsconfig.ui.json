{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "web/src",
    "outDir": "dist",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"]
  },
  "include": ["web/src"],
  "exclude": ["node_modules", "dist", "templates", "docs"]
}
